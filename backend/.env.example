# Database
DATABASE_URL=postgresql://turismo_user:REEMPLAZAR_TURISMO_PG_PASSWORD@localhost:5434/turismo_db

# Redis
REDIS_URL=redis://:REEMPLAZAR_REDIS_PASSWORD@localhost:6380

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AI
# La clave que cifra las API keys de los proveedores en la base (AI_MASTER_KEY).
# NUNCA poner aqui la clave de un entorno real: se genera por instalacion con
#   openssl rand -base64 48
# Si se cambia una clave ya en uso, hay que re-cifrar las filas de APIKey y
# ClaveApi con la anterior antes de activar la nueva (decrypt() falla si no).
AI_MASTER_KEY=REEMPLAZAR__generar_con__openssl_rand_-base64_48

# Clave del admin@tropicalbiohostel.com que crea el seed. En un despliegue es
# OBLIGATORIA: sin ella y sin repo donde anotarla (contenedor), el seed se niega.
# En local puede ir vacia: el seed genera una y la deja en CredencialesAdmin.txt.
ADMIN_PASSWORD=
GEMINI_API_KEY=

# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=turismo-images
R2_PUBLIC_URL=

# App
PORT=3001
FRONTEND_URL=http://localhost:3000

# 1 = simula el pago del apadrinamiento para probar el flujo sin credenciales de PayPal.
# El backend lo ignora con NODE_ENV=production. No lo actives en un entorno real.
SIEMBRA_PAGO_SIMULADO=0
