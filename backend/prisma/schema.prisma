generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoPropiedad {
  hotel
  hostal
  centro_turistico
  glamping
  restaurante
  bar
  finca
  actividad
}

enum EstadoPropiedad {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum PlacementType {
  HOME_BANNER
  SEARCH_RESULTS_TOP
  SEARCH_RESULTS_SIDEBAR
  PROPERTY_DETAIL
}

enum UserRole {
  turista
  propietario
  admin
}

enum MetodoPago {
  TARJETA
  EFECTIVO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  NO_SHOW
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  nombre         String?
  avatarUrl      String?
  role           UserRole       @default(turista)
  supabaseId     String         @unique
  passwordHash   String?
  propiedades    Propiedad[]
  reservas       Reserva[]
  notificaciones Notificacion[]
  bannedUntil    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Propiedad {
  id                   String                  @id @default(cuid())
  nombre               String
  tipo                 TipoPropiedad
  descripcion          String?
  ubicacion            String?
  coordenadas          Json?
  telefono             String?
  email                String?
  whatsapp             String?
  direccion            String?
  ciudad               String?
  departamento         String?
  estrellas            Int                     @default(0)
  horarioCheckIn       String?
  horarioCheckOut      String?
  reglamento           String?
  politicasCancelacion String?
  admiteMascotas       Boolean                 @default(false)
  seguroDisponible     Boolean                 @default(false)
  capacidadMaxima      Int
  numeroHabitaciones   Int?
  numeroBanos          Int?
  tieneCocina          Boolean                 @default(false)
  tieneParqueadero     Boolean                 @default(false)
  tieneWifi            Boolean                 @default(false)
  precioNoche          Decimal                 @db.Decimal(12, 2)
  actividades          String[]
  videos               String[]
  servicioImagenes     String[]                @default([])
  redesSociales        Json?
  icalImportUrls       String[]                @default([])
  icalToken            String?                 @unique
  lastIcalSyncAt       DateTime?
  fuenteDatos          String? // 'manual' | 'seed' | 'osm' | 'web'
  ultimaVerificacion   DateTime?
  verificado           Boolean                 @default(false)
  horarioTexto         String?
  ratingExterno        Float?
  resenasExternas      Int?                    @default(0)
  estado               EstadoPropiedad         @default(BORRADOR)
  slug                 String                  @unique
  owner                User?                   @relation(fields: [ownerId], references: [id])
  ownerId              String?
  images               PropiedadImage[]
  certificados         Certificate[]
  sponsoredListings    SponsoredListing[]
  reviews              Review[]
  reservas             Reserva[]
  actualizaciones      RegistroActualizacion[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([tipo])
  @@index([admiteMascotas])
  @@index([capacidadMaxima])
  @@index([estado])
  @@index([precioNoche])
}

model PropiedadImage {
  id          String    @id @default(cuid())
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId String
  url         String
  thumbUrl    String?
  esPrincipal Boolean   @default(false)
  orden       Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Certificate {
  id               String    @id @default(cuid())
  propiedad        Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId      String
  tipo             String
  archivoUrl       String
  fechaEmision     DateTime?
  fechaVencimiento DateTime?
  createdAt        DateTime  @default(now())
}

model Review {
  id                 String    @id @default(cuid())
  propiedad          Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId        String
  autorNombre        String
  autorEmail         String?
  calificacion       Int
  comentario         String?
  /// Origen de la reseña: 'web' (formulario del sitio) | 'google' | 'tripadvisor'
  fuente             String    @default("web")
  /// Respuesta del anfitrión a la reseña (solo para reseñas traídas de Google)
  respuestaAnfitrion String?
  createdAt          DateTime  @default(now())

  @@index([propiedadId])
  @@index([calificacion])
}

model AIProvider {
  id          String   @id @default(cuid())
  name        String
  apiEndpoint String
  websiteUrl  String
  isActive    Boolean  @default(true)
  /// true = este proveedor (y su key) lo usa Nati, la asistente del chat
  paraChat    Boolean  @default(false)
  apiKeys     APIKey[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model APIKey {
  id         String     @id @default(cuid())
  provider   AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String
  key        String
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())

  @@unique([providerId, key])
}

model Sponsor {
  id                String             @id @default(cuid())
  nombre            String
  logoUrl           String?
  sitioWeb          String?
  contacto          String?
  anuncios          Advertisement[]
  sponsoredListings SponsoredListing[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Advertisement {
  id          String        @id @default(cuid())
  sponsor     Sponsor       @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  sponsorId   String
  titulo      String?
  imagenUrl   String
  linkUrl     String
  placement   PlacementType
  fechaInicio DateTime
  fechaFin    DateTime
  prioridad   Int           @default(0)
  pagoTotal   Decimal       @default(0) @db.Decimal(12, 2)
  activo      Boolean       @default(true)
  impresiones Int           @default(0)
  clicks      Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([placement, activo, fechaFin])
}

model SponsoredListing {
  id          String        @id @default(cuid())
  sponsor     Sponsor       @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  sponsorId   String
  propiedad   Propiedad     @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId String
  placement   PlacementType @default(SEARCH_RESULTS_TOP)
  fechaInicio DateTime
  fechaFin    DateTime
  prioridad   Int           @default(0)
  activo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([placement, activo, fechaFin])
}

model Reserva {
  id             String        @id @default(cuid())
  propiedadId    String
  propiedad      Propiedad     @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  nombre         String
  email          String
  telefono       String
  identificacion String
  fechaLlegada   DateTime
  fechaSalida    DateTime
  huespedes      Int           @default(1)
  metodoPago     MetodoPago    @default(EFECTIVO)
  estado         EstadoReserva @default(PENDIENTE)
  total          Decimal?      @db.Decimal(12, 2)
  notas          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([propiedadId])
  @@index([userId])
  @@index([email])
}

model Notificacion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      String   @default("info")
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, leida])
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model RegistroActualizacion {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  tipo        String // 'verificacion' | 'cambio' | 'nuevo' | 'posible_cierre' | 'enriquecido'
  municipio   String     @default("")
  titulo      String
  detalle     Json?
  estado      String     @default("pendiente") // pendiente | aplicado | descartado
  propiedadId String?
  propiedad   Propiedad? @relation(fields: [propiedadId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([createdAt])
}

model ClaveApi {
  id          String   @id @default(cuid())
  clave       String   @unique // ej: google_places, google_maps
  nombre      String
  descripcion String?
  webUrl      String? // dónde generar la key
  valor       String // cifrado AES-256
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Leads del chat de Nati (CRM de interesados) ---
model LeadChat {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  nombre          String?
  email           String?
  telefono        String?
  ip              String? // IP de origen (intranet/LAN) al momento de conversar
  userAgent       String? // dispositivo/navegador
  mensajesTotal   Int      @default(0)
  primeraPregunta String?
  ultimaPregunta  String?
  prefs           Json? // foto de preferencias: tipo, presupuesto, huéspedes, mascotas, actividad
  temas           String[] @default([]) // intenciones detectadas: yoga, precios, ubicacion, reserva...
  transcript      Json? // últimas 30 intervenciones [{rol, texto}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
  @@index([nombre])
}

// --- Donaciones vía PayPal ---
enum EstadoProyectoDonacion {
  ACTIVO
  PAUSADO
  COMPLETADO
}

enum CategoriaProyecto {
  ARBOLES
  CARBONO
  GENERAL
}

enum EstadoDonacion {
  PENDIENTE
  APROBADA
  CANCELADA
}

model ProyectoDonacion {
  id          String                 @id @default(cuid())
  titulo      String
  slug        String                 @unique
  descripcion String
  categoria   CategoriaProyecto      @default(GENERAL)
  meta        Decimal?               @db.Decimal(12, 2) // meta en la moneda del proyecto (null = sin meta)
  moneda      String                 @default("USD")
  imagenUrl   String?
  media       Json? // [{tipo:"imagen"|"video", url}] galería del proyecto
  paypalLink  String? // link directo paypal.me (respaldo si no hay API)
  estado      EstadoProyectoDonacion @default(ACTIVO)
  orden       Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  donaciones  Donacion[]
  apadrinamientos Apadrinamiento[]

  @@index([estado])
}

model Donacion {
  id              String           @id @default(cuid())
  proyecto        ProyectoDonacion @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId      String
  monto           Decimal          @db.Decimal(12, 2)
  moneda          String           @default("USD")
  nombre          String?
  email           String?
  mensaje         String?
  paypalOrderId   String?          @unique
  paypalCaptureId String?
  estado          EstadoDonacion   @default(PENDIENTE)
  esManual        Boolean          @default(false)
  apadrinamiento  Apadrinamiento?
  /// Donación que pagó un lote de mimamientos (riego, abono, sustrato…).
  cuidados        CuidadoAplicado[]
  createdAt       DateTime         @default(now())

  @@index([proyectoId])
  @@index([estado])
}

// --- Sección Siembra: apadrinar un árbol de café o cacao en el tablero de la finca ---
enum EspecieSiembra {
  CAFE
  CACAO
}

enum EtapaArbol {
  SEMILLA
  BROTE
  JUVENIL
  PRODUCTIVO
}

enum EstadoParcela {
  LIBRE
  RESERVADA // con orden de pago abierta y sin confirmar
  OCUPADA // apadrinamiento confirmado
}

/// Una casilla del ajedrez de siembra. La retícula la define la finca en
/// SiteConfig('siembraTablero'); aquí solo vive la ocupación real.
model Parcela {
  id        String        @id @default(cuid())
  fila      Int
  columna   Int
  estado    EstadoParcela @default(LIBRE)
  /// Una reserva sin captura de pago se libera sola al vencer.
  expiraAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  arbol     Apadrinamiento?

  @@unique([fila, columna])
  @@index([estado])
}

model Apadrinamiento {
  id           String            @id @default(cuid())
  /// El código que recibe el padrino para consultar su árbol sin necesidad de cuenta.
  codigo       String            @unique
  parcela      Parcela           @relation(fields: [parcelaId], references: [id])
  parcelaId    String            @unique
  proyecto     ProyectoDonacion? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  proyectoId   String?
  donacion     Donacion?         @relation(fields: [donacionId], references: [id], onDelete: SetNull)
  donacionId   String?           @unique
  especie      EspecieSiembra
  etapa        EtapaArbol        @default(SEMILLA)
  /// Como lo bautiza quien apadrina. Opcional: no inventamos nombres por él.
  alias        String?
  padrino      String?
  pais         String?
  mensaje      String?
  /// false mientras el pago no se captura; el tablero lo muestra como reserva.
  confirmado   Boolean           @default(false)
  fechaSiembra DateTime?
  /// El parte de la finca sobre este árbol (crecimiento, poda, primera cosecha).
  notasFinca   String?
  /// Cómo está de atendido el árbol: suben con cada mimamiento pagado y bajan
  /// solos con los días. Se materializan al leer, sin tareas programadas.
  aguaNivel      Int       @default(55)
  nutrienteNivel Int       @default(45)
  saludNivel     Int       @default(78)
  /// Desde cuándo se le descuentan los días de sed y de suelo flaco.
  nivelesEn      DateTime?
  ultimoRiego    DateTime?
  ultimoAbono    DateTime?
  cuidados       CuidadoAplicado[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([especie])
  @@index([confirmado])
}

enum CategoriaCuidado {
  AGUA
  ABONO
  SUSTRATO
  CUIDADO
}

/// Lo que la finca publica que cuesta atender un árbol: riego, abono, sustrato, jornal.
/// La lista la mantiene la finca; el código solo la muestra y cobra.
model ItemCuidado {
  id          String            @id @default(cuid())
  clave       String            @unique
  etiqueta    String
  categoria   CategoriaCuidado
  /// Cómo se cuenta: 'L', 'kg' o 'u'.
  unidad      String
  precio      Decimal           @db.Decimal(10, 2)
  descripcion String?
  /// Cuánto le sube a cada nivel una unidad aplicada.
  realceAgua  Int               @default(0)
  realceNutri Int               @default(0)
  realceSalud Int               @default(0)
  activo      Boolean           @default(true)
  orden       Int               @default(0)
  compras     CuidadoAplicado[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([activo, orden])
}

enum EstadoCuidado {
  PENDIENTE
  PAGADO
  CANCELADO
}

/// Un mimamiento comprado para un árbol concreto. Nace pendiente y se aplica al capturar el pago.
model CuidadoAplicado {
  id         String           @id @default(cuid())
  arbol      Apadrinamiento   @relation(fields: [arbolId], references: [id], onDelete: Cascade)
  arbolId    String
  item       ItemCuidado      @relation(fields: [itemId], references: [id])
  itemId     String
  /// La orden de PayPal que pagó este lote (varias líneas comparten una).
  donacion   Donacion?        @relation(fields: [donacionId], references: [id], onDelete: SetNull)
  donacionId String?
  /// Etiqueta, unidad y precio copiados al comprar: si la finca cambia la lista, el historial no se reescribe.
  etiqueta   String
  unidad     String
  cantidad   Decimal          @db.Decimal(6, 2)
  costo      Decimal          @db.Decimal(10, 2)
  moneda     String           @default("USD")
  estado     EstadoCuidado    @default(PENDIENTE)
  createdAt  DateTime         @default(now())

  @@index([arbolId])
  @@index([estado])
}

// --- RAG: base de conocimiento de Nati ---
enum EstadoDocumento {
  PROCESANDO
  LISTO
  ERROR
}

model Documento {
  id          String           @id @default(cuid())
  titulo      String
  fuente      String           @default("manual") // manual | docs | upload
  tipo        String           @default("md") // md | txt | html
  estado      EstadoDocumento  @default(PROCESANDO)
  error       String?
  contenido   String? // texto fuente (para reindexar con otro modelo)
  totalChunks Int              @default(0)
  modeloEmb   String? // modelo de embeddings usado (null = solo FTS)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chunks      ChunkDocumento[]

  @@index([estado])
}

model ChunkDocumento {
  id          String    @id @default(cuid())
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  documentoId String
  orden       Int
  contenido   String
  embedding   Float[] // null = sin vector (solo búsqueda FTS)
  createdAt   DateTime  @default(now())

  @@index([documentoId])
}

// --- Comidas y Menús ---
enum TipoComida {
  DESAYUNO
  ALMUERZO
  CENA
  MERIENDA
  CAFETERIA
  OTRO
}

model Comida {
  id          String     @id @default(cuid())
  titulo      String
  slug        String     @unique
  tipo        TipoComida @default(OTRO)
  descripcion String?
  imagenUrl   String?
  videoUrl    String? // URL de video (YouTube, Vimeo, o archivo subido)
  horario     String? // ej: "Todos los días 7:00 - 10:00"
  activo      Boolean    @default(true)
  orden       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  platos      Plato[]

  @@index([activo])
  @@index([tipo])
}

model Plato {
  id          String   @id @default(cuid())
  comida      Comida   @relation(fields: [comidaId], references: [id], onDelete: Cascade)
  comidaId    String
  nombre      String
  descripcion String?
  categoria   String? // entrada | principal | postre | bebida | extra
  precio      Decimal? @db.Decimal(12, 2) // null = incluido / a convenir
  etiquetas   String[] @default([]) // vegetariano, vegano, sin-gluten, picante, tipico...
  imagenUrl   String? // URL de imagen del plato
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([comidaId])
}
