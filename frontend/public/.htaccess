# Apache .htaccess para despliegue en cPanel (Next.js static export)
# Subir el contenido de frontend/out/ a public_html/ junto con este archivo.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS (descomenta si el dominio ya tiene SSL)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirecciones de URLs antiguas (reemplaza redirects() de next.config.js)
  RewriteRule ^cosmic-bungalo/?$ /cosmic-bungalow/ [R=301,L]
  RewriteRule ^property/cosmic-bungalo/?$ /property/cosmic-bungalow/ [R=301,L]

  # Fallbacks para rutas dinámicas no pre-generadas en static export
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^property/[^/]+/?$ /property/_/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^donaciones/[^/]+/?$ /donaciones/_/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^admin/properties/[^/]+/?$ /admin/properties/_/index.html [L]

  # Archivos/directorios existentes se sirven tal cual
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Next.js export con trailingSlash: /ruta -> /ruta/index.html
  RewriteCond %{REQUEST_URI} /$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f
  RewriteRule ^ %{REQUEST_URI}index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404/index.html [L]
</IfModule>

# Caché de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# No cachear service worker ni manifest
<IfModule mod_headers.c>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
  <FilesMatch "manifest\.webmanifest$">
    Header set Content-Type "application/manifest+json; charset=utf-8"
  </FilesMatch>
  <FilesMatch "manual-de-imagen\.html$">
    Header set X-Robots-Tag "noindex, nosnippet"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
