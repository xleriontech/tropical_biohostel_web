# Cloudflare Pages: reglas de cabecera estáticas.
# El service worker debe SIEMPRE revalidarse para que las actualizaciones
# del sitio se apliquen en los dispositivos que ya lo tienen instalado.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

/offline.html
  Cache-Control: public, max-age=0, must-revalidate

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Las fotos no llevan version en la URL (vienen de la base de datos), asi que
# no pueden ser 'immutable': si se cambia una foto, el navegador tiene que
# revalidarla o seguiria mostrando la anterior.
/fotos/*
  Cache-Control: public, max-age=3600, must-revalidate

/tropical/*
  Cache-Control: public, max-age=3600, must-revalidate
