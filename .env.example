# Database
DATABASE_URL=postgresql://turismo_user:REEMPLAZAR_TURISMO_PG_PASSWORD@localhost:5434/turismo_db

# Redis (local: puerto 6380 y autenticado; ver node bin/credenciales.js)
REDIS_URL=redis://:REEMPLAZAR_REDIS_PASSWORD@localhost:6380

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
# La clave que cifra las API keys de los proveedores en la base (AI_MASTER_KEY).
# NUNCA poner aqui la clave de un entorno real: se genera por instalacion con
#   openssl rand -base64 48
# Si se cambia una clave ya en uso, hay que re-cifrar las filas de APIKey y
# ClaveApi con la anterior antes de activar la nueva (decrypt() falla si no).
AI_MASTER_KEY=REEMPLAZAR__generar_con__openssl_rand_-base64_48

# Clave del panel /admin que crea el seed (backend/prisma/seed.ts). Dejala vacia
# en local: el seed genera una y la anota en CredencialesAdmin.txt. En un
# despliegue (Railway) hay que ponerla: ahi no hay repo donde anotarla.
ADMIN_PASSWORD=

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=turismo-images
R2_PUBLIC_URL=https://your-account-id.r2.dev

# App
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
